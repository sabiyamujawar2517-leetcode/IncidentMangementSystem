@* One place for loading / empty / error states. *@
<div class="state state--@Kind.ToString().ToLowerInvariant()" role="@(Kind == StateKind.Error ? "alert" : "status")">
    @switch (Kind)
    {
        case StateKind.Loading:
            <span class="spinner" aria-hidden="true"></span>
            <p>@(Message ?? "Loading…")</p>
            break;
        case StateKind.Empty:
            <Icon Name="inbox" />
            <p>@(Message ?? "Nothing to show yet.")</p>
            break;
        case StateKind.Error:
            <Icon Name="alert" />
            <p>@(Message ?? "Something went wrong.")</p>
            @if (OnRetry.HasDelegate)
            {
                <button type="button" class="btn btn--primary" @onclick="OnRetry">Retry</button>
            }
            break;
    }
</div>

@code {
    public enum StateKind { Loading, Empty, Error }

    [Parameter, EditorRequired] public StateKind Kind { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
